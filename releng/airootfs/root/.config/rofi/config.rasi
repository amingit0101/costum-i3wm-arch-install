/* @theme "/usr/share/rofi/themes/fullscreen-preview.rasi" */
/* @theme "/usr/share/rofi/themes/sidebar.rasi" */
@theme "/usr/share/rofi/themes/fullscreen-preview.rasi"

configuration {
    /* Modes */
    modi: "drun,run,window,combi";
    combi-modi: "drun,run";
    
    /* Display names */
    display-drun: "  Apps";
    display-run: "  Run";
    display-window: "  Windows";
    display-combi: "  All";
    
    /* Icons */
    show-icons: true;
    icon-theme: "Papirus";
    drun-display-format: "{icon} {name}";
    
    /* Font */
    font: "JetBrains Mono Nerd Font 11";
    
    /* Terminal and browser */
    terminal: "alacritty";
    browser: "firefox";
    
    /* Window format */
    window-format: "{w} • {t}";
    
    /* Sidebar */
    sidebar-mode: false;
    
    /* Location and size */
    location: 0;
    xoffset: 0;
    yoffset: 0;
    width: 50;
    lines: 15;
    padding: 5;
}

